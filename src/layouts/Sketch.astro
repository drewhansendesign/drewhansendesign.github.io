---
// Bare layout for the direction sketches: each sketch brings its own fonts,
// palette and styles. The small switcher lets Drew flip between them.
interface Props {
  title: string;
  current: 'a' | 'b' | 'c';
  bg: string;
}
const { title, current, bg } = Astro.props;
const sketches = [
  { id: 'a', label: 'A' },
  { id: 'b', label: 'B' },
  { id: 'c', label: 'C' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content={bg} />
    <script is:inline>
      // Reveal motion is opt-in: content stays visible without JS or with reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
  </head>
  <body style={`background:${bg}`}>
    <slot />
    <nav class="switcher" aria-label="Direction sketches">
      <span>Sketch</span>
      {sketches.map((s) => (
        <a href={`/sketches/${s.id}/`} aria-current={s.id === current ? 'page' : undefined}>{s.label}</a>
      ))}
    </nav>
    <script>
      // Blur-and-rise reveal for [data-reveal]; siblings stagger via --i.
      if (document.documentElement.classList.contains('motion')) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
  body { margin: 0; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
  img { display: block; max-width: 100%; height: auto; }
  h1, h2, h3, p, ul, ol, dl, dd, figure { margin: 0; }
  ul, ol { padding: 0; list-style: none; }
  a { color: inherit; text-decoration: none; }
  .motion [data-reveal] {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(16px);
    transition:
      opacity 900ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 900ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i, 0) * 90ms);
  }
  .motion [data-reveal].in { opacity: 1; filter: none; transform: none; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }
</style>

<style>
  .switcher {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px 4px 4px 12px;
    border-radius: 999px;
    background: rgb(20 20 20 / 0.85);
    backdrop-filter: blur(8px);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12);
    font: 500 12px/1 ui-sans-serif, system-ui, sans-serif;
    color: #bbb;
  }
  .switcher span { margin-right: 6px; }
  .switcher a {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: #ddd;
  }
  .switcher a:hover { background: rgb(255 255 255 / 0.1); }
  .switcher a[aria-current='page'] { background: #fff; color: #111; }
</style>
