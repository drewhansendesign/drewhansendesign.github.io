---
// One stroke family for every icon: 20px grid, 1.6 stroke, round caps.
type Name = 'arrow-left' | 'arrow-right' | 'arrow-up-right' | 'download' | 'mail' | 'linkedin';
interface Props {
  name: Name;
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-left' && <path d="M16 10H4M9 5l-5 5 5 5" />}
  {name === 'arrow-right' && <path d="M4 10h12M11 5l5 5-5 5" />}
  {name === 'arrow-up-right' && <path d="M6 14 14 6M7 6h7v7" />}
  {name === 'download' && <path d="M10 3.5v9M6 9l4 4 4-4M4 16.5h12" />}
  {name === 'mail' && (
    <>
      <rect x="2.75" y="4.5" width="14.5" height="11" rx="2" />
      <path d="m3.5 5.5 6.5 5 6.5-5" />
    </>
  )}
  {name === 'linkedin' && (
    <>
      <rect x="2.75" y="2.75" width="14.5" height="14.5" rx="3" />
      <path d="M6.5 8.5v5M6.5 6v.01M9.5 13.5v-5M9.5 10.75c0-1.4 1-2.25 2.1-2.25 1.2 0 1.9.8 1.9 2.2v2.8" />
    </>
  )}
</svg>
