---
// A dot-matrix picture of a warehouse aisle in perspective: a wall of pallet
// racking recedes toward a vanishing point, so its uprights, beams and pallet
// boxes land on the dot grid at angles (no tidy 90° lines). Every dot sits on one
// grid; only its brightness changes. Seeded, so it renders the same every build.
import DotField from './DotField.astro';

interface Props {
  seed?: number;
  /** Transition name for the picture (see DotField) */
  name?: string;
}
const { seed = 11, name } = Astro.props;

const PITCH = 16;
// The composition is laid out on a 1440x640 frame (the wide card). The field
// extends past it to the left and top, so a full-screen hero shows more of the
// same picture at the same dot size; the card only ever shows the base frame.
const BASE_COLS = 90;
const BASE_ROWS = 40;
const COLS = 160; // 2560px
const ROWS = 90; // 1440px
const W = BASE_COLS * PITCH;
const H = BASE_ROWS * PITCH;
const OFF_X = (COLS - BASE_COLS) * PITCH; // extension to the left
const OFF_Y = (ROWS - BASE_ROWS) * PITCH; // extension above

// Randomness keyed to each dot's place in the base frame, so extending the
// field never reshuffles the dots inside it
const rnd = (c: number, r: number, k: number) => {
  const x = Math.sin(c * 127.1 + r * 311.7 + k * 74.7 + seed * 17.3) * 43758.5453;
  return x - Math.floor(x);
};
const hash = (a: number, b: number) => {
  const x = Math.sin(a * 127.1 + b * 311.7 + seed * 74.7) * 43758.5453;
  return x - Math.floor(x);
};

// Vanishing point and the rack wall's near edge (top and floor at the right side)
const VX = W * 0.36;
const VY = H * 0.4;
const TOP = -H * 0.25;
const FLOOR = H * 1.05;
const LEVELS = 4; // shelf levels
const BAY = 0.55; // depth between uprights (perspective units)

const dots: { x: number; y: number; a: number }[] = [];
for (let r = 0; r < ROWS; r++) {
  for (let c = 0; c < COLS; c++) {
    // Position in the base frame (negative = in the extension)
    const x = c * PITCH + PITCH / 2 - OFF_X;
    const y = r * PITCH + PITCH / 2 - OFF_Y;
    let k = 0;
    const rand = () => rnd(c - (COLS - BASE_COLS), r - (ROWS - BASE_ROWS), k++);
    let a = 0.025 + rand() * 0.035; // quiet base field

    const t = (x - VX) / (W - VX); // 0 at the vanishing point, 1 at the near edge
    if (t > 0.14) {
      const yTop = VY + (TOP - VY) * t;
      const yBot = VY + (FLOOR - VY) * t;
      if (y >= yTop && y <= yBot) {
        const wallH = yBot - yTop;
        const v = (y - yTop) / wallH; // 0 top, 1 floor
        const d = 1 / t; // depth along the aisle
        // Uprights: nearest upright's screen x
        const n = Math.round((d - 1) / BAY);
        const dn = 1 + n * BAY;
        const xUp = VX + (W - VX) / dn;
        const nearUpright = Math.abs(x - xUp) < PITCH * 0.75;
        // Beams: nearest shelf level in screen space
        const k = Math.round(v * LEVELS);
        const nearBeam = Math.abs(v - k / LEVELS) * wallH < PITCH * 0.6;
        if (nearUpright) a = 0.42 + rand() * 0.18;
        else if (nearBeam) a = 0.34 + rand() * 0.14;
        else {
          // Pallet boxes: each bay and level gets its own stack
          const bay = Math.floor((d - 1) / BAY);
          const lvl = Math.floor(v * LEVELS);
          const h = hash(bay, lvl);
          if (h > 0.22) {
            const fillTop = 1 - (0.35 + hash(bay + 9, lvl) * 0.55); // how high the stack reaches
            const vIn = v * LEVELS - lvl; // 0 top of level, 1 its beam
            const dIn = (d - 1) / BAY - bay; // 0..1 across the bay
            const boxEnd = 0.55 + hash(bay, lvl + 5) * 0.4;
            if (vIn > fillTop && dIn > 0.12 && dIn < boxEnd) {
              const edge = vIn - fillTop < 0.12;
              a = (edge ? 0.3 : 0.16) + rand() * 0.1;
            }
          }
        }
      } else if (y > yBot) {
        // Floor: faint lane lines converging on the vanishing point
        const slope = (y - VY) / Math.max(1, x - VX);
        const lane = Math.abs(((slope * 6) % 1) - 0.5);
        if (lane > 0.44) a = 0.12 + rand() * 0.08;
      }
    }
    if (rand() < 0.018) a = 0.45 + rand() * 0.3; // sparkle
    if (rand() < 0.06) continue; // gaps
    dots.push({ x: x + OFF_X, y: y + OFF_Y, a: Math.round(a * 100) / 100 });
  }
}
---

<DotField dots={dots} cols={COLS} rows={ROWS} pitch={PITCH} align="right" fade="side" class="rack-dots" name={name} />
