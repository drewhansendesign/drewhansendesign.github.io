              <ol>
                {g.rows.map(([name, n, mark]) => (
                  <li class={mark ? `guess-${mark}` : undefined} style={`--n: ${n / 14}`}>
                    <span class="guess-name">{name}</span>
                    <span class="guess-bar" aria-hidden="true"></span>
                    <span class="guess-n">{n}<span class="visually-hidden"> guesses</span></span>
