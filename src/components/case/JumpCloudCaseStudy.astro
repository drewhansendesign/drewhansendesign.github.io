<script>
  import './case-study.ts';

  // The real Lottie files, played over their screens once they scroll near.
  // The loader loops; the success plays, rests, and plays again. Reduced
  // motion shows each one finished and still.
  const slots = [...document.querySelectorAll<HTMLElement>('.jumpcloud [data-lottie]')];
  if (slots.length) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const anims = new Map<HTMLElement, any>();
    let lottie: any;
    const start = async (el: HTMLElement) => {
      lottie ??= (await import('lottie-web/build/player/lottie_light')).default;
      const loop = el.hasAttribute('data-loop');
      const anim = lottie.loadAnimation({ container: el, renderer: 'svg', loop: loop && !reduce, autoplay: false, path: el.dataset.lottie });
      anims.set(el, anim);
      anim.addEventListener('DOMLoaded', () => {
        if (reduce) anim.goToAndStop(loop ? Math.round(anim.totalFrames * 0.45) : anim.totalFrames - 1, true);
        else if (el.dataset.visible === '1') anim.play();
      });
      if (!loop && !reduce) {
        anim.addEventListener('complete', () => {
          setTimeout(() => { if (el.dataset.visible === '1') anim.goToAndPlay(0, true); }, 1800);
        });
      }
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const el = e.target as HTMLElement;
        el.dataset.visible = e.isIntersecting ? '1' : '0';
        const anim = anims.get(el);
        if (!anim) { if (e.isIntersecting) start(el); continue; }
        if (reduce) continue;
        if (e.isIntersecting) { if (anim.isPaused) anim.goToAndPlay(0, true); }
        else anim.pause();
      }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.4 });
    slots.forEach((el) => io.observe(el));
  }
</script>

