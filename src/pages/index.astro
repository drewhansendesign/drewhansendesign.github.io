---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Wordmark from '../components/Wordmark.astro';
import LogoStrip from '../components/LogoStrip.astro';
import WorkCard from '../components/WorkCard.astro';
import { work, experience, expertise, process, contact } from '../data/site';
import portrait from '../assets/about/drew-portrait.png';
import skylark from '../assets/about/skylark.jpg';
import superheaven from '../assets/about/superheaven.jpg';
import curling from '../assets/about/curling.jpg';
import goose from '../assets/about/goose.jpg';
import ibottaRaw from '../assets/logos/ibotta.svg?raw';
import Iconoir from '../components/Iconoir.astro';
import ContactMenu from '../components/ContactMenu.astro';

const headline = ['I', 'sweat', 'the', 'details', 'so', 'you', 'don’t', 'have', 'to.'];

// About: off the clock, in Drew's photos and words. focus = object-position
// for the 4:5 crop.
const offClock = [
  {
    src: superheaven,
    focus: '50% 50%',
    alt: 'Superheaven on a blue-lit stage, with a crowd surfer riding over the crowd.',
    title: 'Loud music',
    body: 'Shows of all kinds, but mostly metal. All-time favorite band: Every Time I Die.',
  },
  {
    src: skylark,
    focus: '52% 50%',
    alt: 'Drew and Charlotte outside the Skylark Lounge, its marquee reading “Charlotte & Drew, 05 16 2026.”',
    title: 'Married in a dive bar',
    body: 'Charlotte and I tied the knot at the Skylark Lounge. It felt right.',
  },
  {
    src: curling,
    focus: '52% 50%',
    alt: 'Drew sweeping a curling stone down the ice alongside a teammate.',
    title: 'The Sheet Freaks',
    body: 'Every Friday my father-in-law screams “SWEEP!” at Charlotte and me. It works: second place in our (casual) league.',
  },
  {
    src: goose,
    focus: '50% 50%',
    alt: 'Goose, a fluffy Great Pyrenees mix, posing beside a “First day of Skiptown” sign.',
    title: 'Goose',
    body: 'Our Great Pyrenees mix puppy who got kicked out of doggy daycare for being too friendly. He just won’t stop playing.',
  },
];

// The Ibotta wordmark, inline in the intro: brand pink via currentColor, and
// without the ® (about 2px tall at this size)
const ibottaLogo = ibottaRaw
  .trim()
  .replace(/<path d="M90\.6344[^>]*\/>/, '')
  .replace(/fill="#1C1F24"/g, 'fill="currentColor"')
  .replace(/<svg[^>]*>/, '<svg viewBox="0 0 89 26" aria-hidden="true" focusable="false">');
---

<Base
  intro
  title="Drew Hansen, Senior Product Designer"
  description="Drew Hansen is a senior product designer in Denver with a motion design background, designing new experiences and modernizing legacy ones for brands like Sam's Club, Tinder and The North Face."
>
  <header class="top wrap">
    <div class="top-id">
      <Wordmark />
      <p class="top-name">Drew Hansen</p>
    </div>
    <ContactMenu />
  </header>

  <section class="hero wrap" aria-labelledby="hero-title">
    <h1 id="hero-title">
      {headline.map((w, i) => (
        <><span class="word" data-reveal style={`--i:${i}`}>{w}</span>{' '}</>
      ))}
    </h1>
    <div class="hero-foot">
      <p data-reveal style="--i:9">
        I'm a senior product designer currently changing the digital coupon game at{' '}
        <span class="nowrap"><a class="ibotta" href="https://home.ibotta.com/" target="_blank" rel="noopener"><span class="visually-hidden">Ibotta (opens in a new tab)</span><Fragment set:html={ibottaLogo} /></a>.</span>{' '}
        For over a decade I've designed new products, modernized legacy ones, and everything in
        between.
      </p>
    </div>
  </section>


  <section id="work" class="work wrap" aria-labelledby="work-title">
    <h2 id="work-title" class="visually-hidden">Selected work</h2>
    <div class="cards">
      {work.map((w, i) => (
        <WorkCard work={w} wide={i === 0 || i === work.length - 1} showImpact={i === 0} texture={i === 0 ? "dots" : i === 1 ? "map" : i === 2 ? "topo" : i === 3 ? "network" : undefined} index={10 + i} onLoad />
      ))}
    </div>
  </section>


  <section id="experience" class="exp wrap" aria-labelledby="exp-title">
    <h2 id="exp-title" class="callout" data-reveal>Experience</h2>
    <ol class="timeline">
      {experience.map((r, i) => (
        <li class:list={['stop', r.current && 'current']} data-reveal style={`--i:${i % 3}`}>
          <span class="node" aria-hidden="true"></span>
          <div class="stop-body">
            <p class="stop-meta">
              <span class="stop-dates">{r.dates}</span>
            </p>
            <h3 class="stop-co">{r.company}</h3>
            <p class="stop-role">{r.role}</p>
            {r.body && <p class="stop-text">{r.body}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="trusted" aria-label="Brands I've designed for" data-reveal>
    <LogoStrip variant="marquee" />
  </section>

  <section id="expertise" class="expertise wrap" aria-labelledby="expertise-title">
    <h2 id="expertise-title" class="callout" data-reveal>Expertise</h2>
    <ul class="skills">
      {expertise.map((x, i) => (
        <li class="skill" data-reveal style={`--i:${i}`}>
          <span class="skill-icon"><Iconoir name={x.icon} /></span>
          <h3 class="skill-title">{x.title}</h3>
          <p class="skill-text">{x.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="about" class="about wrap" aria-labelledby="about-title">
    <div class="about-intro">
      <div class="about-img" data-reveal>
        <Image
          src={portrait}
          alt="Drew Hansen in a black cap and glasses."
          widths={[480, 900]}
          sizes="(min-width: 960px) 40vw, 100vw"
          loading="lazy"
        />
      </div>
      <div class="about-text">
        <h2 id="about-title" class="callout" data-reveal>So, who’s Drew?</h2>
        <p data-reveal style="--i:1">
          I started out making things move for broadcast TV and never really stopped. At JumpCloud I
          was known as “Delightful Drew,” the one adding the final polish and animation that makes an
          interface feel good to use. These days I’m mostly known for speed: lots of ideas, fast,
          without letting the quality slip. I show up with plenty of opinions, but I hold them
          loosely. The best idea wins, even when it isn’t mine.
        </p>
      </div>
    </div>

    <div class="process">
      <h3 class="process-title" data-reveal>How I work, <span>in a perfect world</span></h3>
      <ol class="steps">
        {process.map((s, i) => (
          <li class="step" data-reveal style={`--i:${i}`}>
            <span class="node" aria-hidden="true"></span>
            <p class="step-num">{String(i + 1).padStart(2, '0')}</p>
            <h4 class="step-title">{s.title}</h4>
            <p class="step-text">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="reality">
      <h3 class="process-title" data-reveal>How I work, <span>in the real world</span></h3>
      <!-- The same four steps' rail, as it actually goes: doubling back, looping,
           and still arriving. Draws itself in as it scrolls into view. -->
      <div class="squiggle" aria-hidden="true" data-reveal>
        <svg viewBox="0 16 1200 128">
          <defs>
            <linearGradient id="squiggle-ink" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1200" y2="0">
              <stop offset="0" style="stop-color: var(--text-3)" />
              <stop offset="0.7" style="stop-color: var(--text-2)" />
              <stop offset="1" style="stop-color: var(--accent)" />
            </linearGradient>
          </defs>
          <path
            d="M 6 80 C 120 80 180 80 250 76 C 330 70 360 30 320 26 C 270 22 260 120 340 124 C 420 128 440 40 500 48 C 560 56 520 140 470 120 C 420 100 520 20 610 36 C 700 52 640 130 720 128 C 800 126 780 30 860 40 C 930 48 900 110 870 104 C 840 98 900 70 980 78 C 1060 86 1120 80 1194 80"
          />
        </svg>
        <span class="node sq-start"></span>
        <span class="node sq-end"></span>
        <span class="sq-label sq-label-start">Kickoff</span>
        <span class="sq-label sq-label-end">Shipped anyway</span>
      </div>
      <div class="reality-text">
        <p data-reveal>
          I can’t remember the last project that didn’t get squished or pivoted. Steps get swapped,
          compressed or skipped, and that’s fine. Being adaptable means still getting shit done when
          the plan falls apart. The one thing I never skip is getting something down fast, whether
          it’s a sketch or an AI prototype. I understand a problem best when I can see it.
        </p>
        <p class="pitch" data-reveal style="--i:1">
          If you want a cerebral overthinker who’s still workshopping the problem statement in week
          six, I’m probably not your guy. If you want to build fast, iterate and make cool shit, let’s chat.
        </p>
      </div>
    </div>

    <div class="offclock">
      <h3 class="process-title" data-reveal>Off the clock</h3>
      <ul class="snaps">
        {offClock.map((s, i) => (
          <li class="snap" data-reveal style={`--i:${i}`}>
            <div class="snap-img">
              <Image
                src={s.src}
                alt={s.alt}
                widths={[400, 800]}
                sizes="(min-width: 900px) 22vw, 45vw"
                quality={90}
                loading="lazy"
                style={`object-position: ${s.focus}`}
              />
            </div>
            <h4 class="snap-title">{s.title}</h4>
            <p class="snap-text">{s.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="contact" class="contact wrap" aria-labelledby="contact-title">
    <h2 id="contact-title" class="callout callout-xl" data-reveal>Let’s work together.</h2>
    <div class="contact-links" data-reveal style="--i:1">
      <a class="pill pill-solid" href={`mailto:${contact.email}`}>{contact.email}</a>
      <a class="pill" href={contact.linkedin} target="_blank" rel="me noopener">LinkedIn<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a class="pill" href={contact.resume} download>Resume</a>
    </div>
  </section>
</Base>

<script>
  // The real-world squiggle: keep its line a steady 2px at any width (the SVG
  // scales with the column), and draw it in once it's well into view.
  const sq = document.querySelector<HTMLElement>('.squiggle');
  const svg = sq?.querySelector('svg');
  const path = sq?.querySelector('path');
  if (sq && svg && path) {
    const fit = () => {
      const w = svg.getBoundingClientRect().width;
      if (w) path.style.strokeWidth = `${(2 * 1200) / w}px`;
    };
    fit();
    new ResizeObserver(fit).observe(svg);

    if (document.documentElement.classList.contains('motion') && 'IntersectionObserver' in window) {
      sq.style.setProperty('--len', `${Math.ceil(path.getTotalLength()) + 2}`);
      sq.classList.add('armed');
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          sq.classList.add('drawn');
        },
        { rootMargin: '0px 0px -25% 0px', threshold: 1 }
      );
      io.observe(svg);
    }
  }
</script>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1.75rem;
  }
  .top :global(.wordmark) {
    font-family: inherit;
  }
  /* The mark with the name beside it, set like the share image */
  .top-id {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .top-name {
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--text-1);
  }

  .hero {
    padding-block: clamp(5rem, 12vw, 10rem) clamp(4rem, 8vw, 7rem);
  }
  h1 {
    max-width: 14ch;
    font-size: var(--fs-hero);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.03em;
    word-spacing: 0.04em;
  }
  /* From tablet up, keep the headline on two lines: the type never outgrows
     the column it has to fit (the longer line is about 9.1em) */
  @media (min-width: 800px) {
    h1 {
      font-size: min(var(--fs-hero), (100vw - 2 * var(--gutter)) / 9.3);
    }
  }
  .word {
    display: inline-block;
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .hero-foot p {
    max-width: 46ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--text-2);
  }
  /* The sentence's period stays on the logo's line */
  .nowrap {
    white-space: nowrap;
  }
  /* Ibotta's wordmark standing in for the name, in their bright ruby */
  .ibotta {
    color: #ff3a78;
    transition: color 200ms ease;
  }
  .ibotta:hover {
    color: #ff6b98;
  }
  .ibotta :global(svg) {
    display: inline-block;
    height: 0.88em;
    width: auto;
    margin-left: 0.08em;
    vertical-align: -0.04em;
    overflow: visible;
  }

  .trusted {
    --logo-knock: var(--bg);
    padding-top: var(--section-gap);
  }

  /* The cards follow the intro directly */
  .work {
    padding-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .exp {
    padding-top: var(--section-gap);
  }
  .exp .callout {
    margin-bottom: 2.5rem;
  }
  /* Timeline: a rail with a node per role, details to the right */
  .timeline {
    position: relative;
    --rail-x: 5.5px;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: var(--rail-x);
    top: 0.9rem;
    bottom: 0.9rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--accent) 0, var(--line-strong) 9rem, var(--line) 100%);
    translate: -0.5px 0;
  }
  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: start;
    padding-block: 0 clamp(2.25rem, 1.5rem + 2vw, 3.25rem);
  }
  .stop:last-child {
    padding-bottom: 0;
  }
  .node {
    justify-self: start;
    width: 11px;
    height: 11px;
    margin-top: 0.55rem;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--text-3);
  }
  .current .node {
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }
  .stop-body {
    display: grid;
    gap: 0.2rem;
    max-width: 60ch;
  }
  .stop-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--fs-meta);
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .stop-co {
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.15;
  }
  .stop-role {
    color: var(--text-2);
  }
  .stop-text {
    margin-top: 0.6rem;
    color: var(--text-3);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .expertise {
    padding-top: var(--section-gap);
  }
  .expertise .callout {
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3rem clamp(1.5rem, 3vw, 3rem);
  }
  .skill-icon {
    display: block;
    color: var(--text-1);
  }
  /* Iconoir draws on a 24px grid with a little inset; pull it back to the text edge */
  .skill-icon :global(svg) {
    display: block;
    width: 32px;
    height: 32px;
    margin-left: -3px;
  }
  .skill-title {
    margin-top: 1.25rem;
    font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.15;
  }
  .skill-text {
    max-width: 34ch;
    margin-top: 0.75rem;
    color: var(--text-3);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .about {
    padding-top: var(--section-gap);
  }
  .about-intro {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .about-img {
    overflow: hidden;
    border-radius: 24px;
  }
  .about-img :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .about-text {
    display: grid;
    gap: 1.5rem;
  }
  .about-text p {
    max-width: 38ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--text-2);
  }
  /* Off the clock: four photos with short captions */
  .offclock {
    margin-top: clamp(5rem, 3rem + 6vw, 9rem);
  }
  .snaps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem clamp(1.25rem, 2.5vw, 2rem);
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .snap-img {
    overflow: hidden;
    border-radius: var(--radius-img);
    background: var(--surface-2);
  }
  .snap-img :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .snap-title {
    margin: 1.25rem 0 0;
    font-size: clamp(1.125rem, 1rem + 0.3vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.2;
  }
  .snap-text {
    max-width: 34ch;
    margin-top: 0.5rem;
    color: var(--text-3);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  /* Process: the ideal steps on a straight rail, then the same rail as it
     really goes */
  .process {
    margin-top: clamp(5rem, 3rem + 6vw, 9rem);
  }
  .reality {
    margin-top: clamp(4.5rem, 3rem + 5vw, 7.5rem);
  }
  .process-title {
    font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.05;
  }
  .process-title span {
    color: var(--text-3);
  }
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 clamp(1.5rem, 3vw, 3rem);
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .steps::before {
    content: '';
    position: absolute;
    top: 5.5px;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(to right, var(--line-strong), var(--line));
    translate: 0 -0.5px;
  }
  .step .node {
    display: block;
    position: relative;
    margin-top: 0;
  }
  .step-num {
    margin-top: 1.5rem;
    font-size: var(--fs-meta);
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  .step-title {
    margin: 0.35rem 0 0;
    font-size: clamp(1.25rem, 1.1rem + 0.4vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 1.15;
  }
  .step-text {
    max-width: 34ch;
    margin-top: 0.75rem;
    color: var(--text-3);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .squiggle {
    position: relative;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-bottom: 1.75rem;
  }
  .squiggle svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .squiggle path {
    fill: none;
    stroke: url(#squiggle-ink);
    stroke-width: 2px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The nodes sit on the line's ends (mid-height, x = 6 and 1194 of 1200) */
  .squiggle .node {
    position: absolute;
    top: calc(50% - 0.875rem);
    margin: 0;
    translate: -50% -50%;
  }
  .sq-start {
    left: 0.5%;
  }
  .sq-end {
    left: 99.5%;
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }
  .sq-label {
    position: absolute;
    bottom: 0;
    font-size: var(--fs-meta);
    color: var(--text-3);
    white-space: nowrap;
  }
  .sq-label-start {
    left: 0;
  }
  .sq-label-end {
    right: 0;
    color: var(--accent-text);
  }
  /* Drawn in by the script below once in view: the line runs with a steady
     ease, and the end node lands with a small overshoot just before it
     arrives. Without JS, or with reduced motion, it's simply drawn. */
  /* (Transitions live on the drawn state, so arming hides things at once) */
  .squiggle.armed path {
    stroke-dasharray: var(--len) var(--len);
    stroke-dashoffset: var(--len);
    opacity: 0;
  }
  .squiggle.armed .sq-end {
    opacity: 0;
    scale: 0.4;
  }
  .squiggle.armed .sq-label-end {
    opacity: 0;
    translate: 0 6px;
  }
  .squiggle.armed.drawn path {
    stroke-dashoffset: 0;
    opacity: 1;
    transition:
      stroke-dashoffset 2200ms cubic-bezier(0.45, 0.05, 0.25, 1),
      opacity 300ms ease;
  }
  .squiggle.armed.drawn .sq-end {
    opacity: 1;
    scale: 1;
    transition:
      opacity 400ms ease 1850ms,
      scale 700ms cubic-bezier(0.34, 1.56, 0.64, 1) 1850ms;
  }
  .squiggle.armed.drawn .sq-label-end {
    opacity: 1;
    translate: none;
    transition:
      opacity 500ms ease 2000ms,
      translate 700ms var(--ease-out) 2000ms;
  }

  .reality-text {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem clamp(2rem, 6vw, 6rem);
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .reality-text p {
    max-width: 46ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
