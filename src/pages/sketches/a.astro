---
// Sketch A, "Studio": Buff Motion's calm, considered motion and big callout headings,
// with Linear's contrast and clearly separated sections.
import '@fontsource-variable/host-grotesk';
import { Image } from 'astro:assets';
import Sketch from '../../layouts/Sketch.astro';
import Wordmark from '../../components/Wordmark.astro';
import LogoStrip from '../../components/LogoStrip.astro';
import { work, experience, contact } from '../../data/site';
import portrait from '../../assets/about/drew-portrait.png';

const [feature, ...rest] = work;
const headline = ['Complex', 'systems,', 'made', 'simple', 'to', 'use.'];
---

<Sketch title="Sketch A: Studio, Drew Hansen" current="a" bg="#08090a">
  <div class="page">
    <header class="top wrap">
      <Wordmark />
      <nav aria-label="Contact">
        <a href={`mailto:${contact.email}`}>Email</a>
        <a href={contact.resume} download>Resume</a>
      </nav>
    </header>

    <section class="hero wrap" aria-labelledby="a-h1">
      <h1 id="a-h1">
        {headline.map((w, i) => (
          <span class="word" data-reveal style={`--i:${i}`}>{w}</span>
        ))}
      </h1>
      <div class="hero-foot">
        <p data-reveal style="--i:6">
          I'm Drew, a senior product designer with a motion design background. For over a decade
          I've been modernizing legacy platforms for brands like Sam's Club, Tinder and The North Face.
        </p>
        <a class="pill" href="#a-work" data-reveal style="--i:7">See the work</a>
      </div>
    </section>

    <section class="trusted" aria-label="Companies I've designed for" data-reveal>
      <p class="trusted-label wrap">Brands I've designed for</p>
      <LogoStrip variant="marquee" />
    </section>

    <section id="a-work" class="work wrap" aria-labelledby="a-work-h">
      <h2 id="a-work-h" class="callout" data-reveal>Selected work</h2>

      <a href={`/work/${feature.slug}/`} class="feature" data-reveal>
        <div class="feature-img">
          <Image src={feature.image} alt={feature.imageAlt} widths={[960, 1440, 1920]} sizes="(min-width: 1280px) 1200px, 100vw" loading="lazy" />
        </div>
        <div class="feature-body">
          <div>
            <p class="meta">{feature.company} &middot; {feature.year}</p>
            <h3>{feature.title}</h3>
            <p class="sum">{feature.summary}</p>
          </div>
          {feature.impact && (
            <dl class="impact">
              {feature.impact.map((m) => (
                <div>
                  <dt>{m.value}</dt>
                  <dd>{m.label}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </a>

      <div class="grid">
        {rest.map((w, i) => (
          <a href={`/work/${w.slug}/`} class="card" data-reveal style={`--i:${i}`}>
            <div class="card-img">
              <Image src={w.image} alt={w.imageAlt} widths={[640, 960]} sizes="(min-width: 960px) 33vw, 100vw" loading="lazy" />
            </div>
            <p class="meta">{w.company} &middot; {w.year}</p>
            <h3>{w.title}</h3>
            <p class="sum">{w.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="exp wrap" aria-labelledby="a-exp-h">
      <h2 id="a-exp-h" class="callout" data-reveal>Experience</h2>
      <ol>
        {experience.map((r, i) => (
          <li data-reveal style={`--i:${i % 3}`}>
            <span class="exp-dates">{r.dates}</span>
            <span class="exp-co">{r.company}</span>
            <span class="exp-role">{r.role}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="about wrap" aria-labelledby="a-about-h">
      <div class="about-img" data-reveal>
        <Image src={portrait} alt="Drew Hansen in a black cap and glasses." widths={[480, 900]} sizes="(min-width: 960px) 40vw, 100vw" loading="lazy" />
      </div>
      <div class="about-text">
        <h2 id="a-about-h" class="callout" data-reveal>Hey, I'm Drew.</h2>
        <p data-reveal style="--i:1">
          I started in broadcast motion graphics, studied New Media Design at RIT, and have spent
          the last decade designing mobile-first products and the design systems behind them.
          Motion is still how I make interactions feel lovable.
        </p>
        <p class="off" data-reveal style="--i:2">Off the clock: metal shows, curling and sim racing in Denver.</p>
      </div>
    </section>

    <section class="contact wrap" aria-labelledby="a-contact-h">
      <h2 id="a-contact-h" class="callout big" data-reveal>Let's work together.</h2>
      <div class="contact-links" data-reveal style="--i:1">
        <a class="pill solid" href={`mailto:${contact.email}`}>{contact.email}</a>
        <a class="pill" href={contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="pill" href={contact.resume} download>Resume</a>
      </div>
    </section>
  </div>
</Sketch>

<style>
  .page {
    --ink: #f5f5f3;
    --ink-2: #a9aaa6;
    --ink-3: #7f807c;
    --line: rgb(255 255 255 / 0.1);
    --surface: #111214;
    --accent: #237cf9;
    --accent-text: #6aa6ff;
    --logo-knock: #08090a;
    color: var(--ink);
    font-family: 'Host Grotesk Variable', system-ui, sans-serif;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .wrap { max-width: 1280px; margin-inline: auto; padding-inline: clamp(16px, 4vw, 48px); }

  .top { display: flex; justify-content: space-between; align-items: center; padding-block: 1.75rem; }
  .top :global(.wordmark) { font-family: inherit; }
  .top nav { display: flex; gap: 1.75rem; font-size: 0.9375rem; color: var(--ink-2); }
  .top nav a:hover { color: var(--ink); }

  .hero { padding-block: clamp(5rem, 12vw, 10rem) clamp(4rem, 8vw, 7rem); }
  h1 {
    font-size: clamp(3.25rem, 1rem + 8.5vw, 9.5rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.045em;
    max-width: 12ch;
  }
  .word { display: inline-block; margin-right: 0.22em; }
  .hero-foot { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 2rem; margin-top: clamp(2.5rem, 5vw, 4rem); }
  .hero-foot p { max-width: 46ch; font-size: 1.25rem; line-height: 1.45; color: var(--ink-2); }
  .pill {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding-inline: 1.5rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line);
    font-weight: 550;
    transition: background-color 250ms ease, box-shadow 250ms ease;
  }
  .pill:hover { background: rgb(255 255 255 / 0.06); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25); }
  .pill.solid { background: var(--ink); color: #08090a; box-shadow: none; }
  .pill.solid:hover { background: #fff; }

  .trusted { padding-block: 3rem; border-block: 1px solid var(--line); }
  .trusted-label { margin-bottom: 1.75rem; font-size: 0.875rem; color: var(--ink-3); }

  .callout {
    font-size: clamp(2.75rem, 1rem + 5.5vw, 6rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }
  .callout.big { font-size: clamp(3.25rem, 1rem + 8vw, 9rem); max-width: 10ch; }

  .work { padding-top: clamp(6rem, 12vw, 10rem); }
  .work .callout { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .feature { display: grid; gap: 2rem; }
  .feature-img, .card-img { overflow: hidden; border-radius: 20px; background: var(--surface); }
  .feature-img :global(img), .card-img :global(img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1); }
  .feature:hover :global(img), .card:hover :global(img) { transform: scale(1.03); }
  .feature-body { display: grid; grid-template-columns: 5fr 7fr; gap: 3rem; align-items: start; }
  .meta { font-size: 0.875rem; color: var(--ink-3); }
  h3 { margin-top: 0.35rem; font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; }
  .feature:hover h3, .card:hover h3 { color: var(--accent-text); }
  .sum { margin-top: 0.75rem; color: var(--ink-2); max-width: 52ch; }
  .impact { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border-radius: 16px; overflow: hidden; }
  .impact div { padding: 1.5rem; background: #0d0e10; }
  .impact dt { font-size: clamp(2rem, 1.2rem + 2vw, 3.25rem); font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .impact dd { margin-top: 0.5rem; color: var(--ink-2); font-size: 0.9375rem; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 3vw, 2.5rem); margin-top: clamp(4rem, 8vw, 6rem); }
  .card { display: grid; align-content: start; gap: 0.25rem; }
  .card-img { margin-bottom: 1rem; border-radius: 16px; }
  .card h3 { font-size: 1.5rem; }

  .exp { padding-top: clamp(7rem, 14vw, 12rem); }
  .exp .callout { margin-bottom: 2.5rem; }
  .exp li {
    display: grid;
    grid-template-columns: 12rem 1fr 1fr;
    gap: 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 1.125rem;
  }
  .exp-dates { color: var(--ink-3); font-size: 0.9375rem; font-variant-numeric: tabular-nums; padding-top: 0.15em; }
  .exp-co { font-weight: 600; }
  .exp-role { color: var(--ink-2); }

  .about { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; padding-top: clamp(7rem, 14vw, 12rem); }
  .about-img { overflow: hidden; border-radius: 24px; }
  .about-img :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .about-text { display: grid; gap: 1.5rem; }
  .about-text p { font-size: 1.375rem; line-height: 1.45; color: var(--ink-2); max-width: 38ch; }
  .about-text .off { font-size: 1.0625rem; color: var(--ink-3); }

  .contact { padding-block: clamp(8rem, 16vw, 14rem) clamp(6rem, 10vw, 9rem); }
  .contact-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.5rem; }

  @media (max-width: 960px) {
    .feature-body, .about { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr; }
    .exp li { grid-template-columns: 1fr; gap: 0.15rem; }
  }
  @media (max-width: 520px) {
    .impact { grid-template-columns: 1fr 1fr; }
    .impact div { padding: 1.1rem; }
  }
</style>
